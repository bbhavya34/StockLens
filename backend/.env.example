# Set SUPABASE_DATABASE_URL in your shell using the exact, project-specific URI
# from Supabase Dashboard > Connect. Do not copy placeholder hostnames from docs.
# Prefer direct mode for migrations and IPv6-capable persistent backends, or the
# session pooler (port 5432) for persistent backends on IPv4-only networks.
# These two public Auth values must match the frontend project. Never use the
# service-role or secret key in the browser.
SUPABASE_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
